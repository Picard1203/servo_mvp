{"nodes": [{"id": "context_air_gapped_deployment", "label": "Air-Gapped Deployment", "file_type": "rationale", "rationale": "Final deployment is air-gapped; the dev board has WiFi, production ones will not. Develop as if already air-gapped so shipping is 'zip the folder'. This constraint drives the no-framework, no-bricks, vendored-libraries and wheelhouse decisions.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_no_framework", "label": "Plain HTML/CSS/JS, No Framework", "file_type": "rationale", "rationale": "Air-gap: there is no build pipeline to vendor.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_lcars_theme", "label": "LCARS Light Theme With ISA-101 Safety Colours", "file_type": "rationale", "rationale": "Chosen after many iterations.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_typed_inputs", "label": "Typed Inputs, Not Sliders", "file_type": "rationale", "rationale": "Operators need exact angles.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_travel_window", "label": "Plus/Minus 90 Degree Travel Window", "file_type": "rationale", "rationale": "180 degrees of output equals 264 servo degrees equals 3004 counts, inside one servo turn of 4096, so no multi-turn is needed. The datum must sit mid-travel near 2048.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_degrees_per_count", "label": "0.06 Degrees Per Count", "file_type": "concept", "rationale": "4096 counts per servo turn through a 44:30 belt gives (360/4096)x(30/44) = 0.0599 degrees at the output.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_zero_deadband", "label": "Zero Deadband", "file_type": "concept", "rationale": "Measured landing error: 0 gives 0.06 deg, 1 gives 0.10, 8 gives 0.52, 32 gives 1.98.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_speed_saturation", "label": "Speed Saturates Near 1100 Counts/s", "file_type": "concept", "rationale": "About 66 deg/s at the output whatever is commanded; acceleration has no measurable effect above about 50.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_serial1_1mbps", "label": "Serial1 At 1 Mbps", "file_type": "concept", "rationale": "Bench-verified reliable: 200 of 200 reads at 220 microseconds.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_working_reference_first", "label": "Read The Working Reference Before Rewriting", "file_type": "rationale", "rationale": "Several bugs came from re-deriving solved behaviour instead of porting it.", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "context_air_gapped_deployment", "target": "context_no_framework", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "context_air_gapped_deployment", "target": "app_no_bricks", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "context_air_gapped_deployment", "target": "libraries_readme_vendo