{"nodes": [{"id": "sketch_readme_src_no_preprocessing", "label": "src/ Avoids .ino Preprocessing", "file_type": "rationale", "rationale": "Arduino compiles src/ recursively and does no preprocessing on .cpp/.h files. Only .ino files get concatenated and have prototypes generated, so logic in src/ is ordinary reviewable C++.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_angleconverter", "label": "AngleConverter", "file_type": "concept", "rationale": "Converts counts to and from output degrees including direction sign.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_signmagnitude", "label": "SignMagnitude", "file_type": "concept", "rationale": "STS wire-format decode; the source of the 'reads 32700' bug.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_servofaults", "label": "ServoFaults", "file_type": "concept", "rationale": "Decodes status register 0x41 into six named flags.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_servobus", "label": "ServoBus", "file_type": "concept", "rationale": "The only place that touches the serial bus: retries and the EEPROM unlock ritual.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_servocontroller", "label": "ServoController", "file_type": "concept", "rationale": "The operations the backend asks for.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_spiremap", "label": "SpiRemap", "file_type": "concept", "rationale": "Routes SPI2 to the ICSP header so the Ethernet shield is visible.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_networkrelay", "label": "NetworkRelay", "file_type": "concept", "rationale": "Shield to Linux byte pump with a callback seam and no Bridge dependency.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_bridgeapi", "label": "BridgeApi", "file_type": "concept", "rationale": "The contract with Python; the only file that knows payload formats.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_app", "label": "App Composition Root", "file_type": "concept", "rationale": "Builds the object graph once and drives it; sketch.ino is four lines that hand off to App.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_spiremap_twice", "label": "Apply SpiRemap Twice", "file_type": "rationale", "rationale": "Ethernet.init() re-initialises the SPI pins and undoes the first remap, so it must be applied again afterwards or the W5500 reports 'no hardware'.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_drain_with_while", "label": "Drain With while, Never if", "file_type": "rationale", "rationale": "The UART RX ring is 64 bytes and socket buffers are small; one byte per loop() is not fast enough.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_tinytest", "label": "TinyTest.h Harness", "file_type": "concept", "rationale": "About 60 lines and deliberately not AUnit or GoogleTest: every dependency is a liability on an air-gapped machine.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_header_only_testable", "label": "Header-Only Arduino-Free Classes", "file_type": "rationale", "rationale": "AngleConverter, SignMagnitude and ServoFaults are header-only and Arduino-free on purpose, which is what makes them compilable with plain g++ on a development machine.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_native_tests", "label": "Host-Native Test Tier", "file_type": "concept", "rationale": "No board, no libraries, milliseconds. Covers sign-magnitude decoding, angle round-trips within one count, the travel window fitting one servo turn, direction mirroring, speed conversion and every status bit.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_ontarget_tests", "label": "On-Target Test Tier", "file_type": "concept", "rationale": "Covers only what a host cannot: that the servo answers, that configuration writes stick, that a commanded move lands and that stop holds. Not compiled into the main sketch because recursive compilation is limited to src/.", "source_file": "sketch/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sketch_readme_csv_payload_contract", "label": "CSV Bridge Payload Contract", "file_type": "concept", "rationale": "Plain comma-separated payloads are readable in a log and neither side can drift from a field order the other assumes. Snapshot fields: valid,counts,moving,temp_c,volt_v,