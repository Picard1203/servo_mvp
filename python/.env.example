# Servo Control MVP - configuration
# Every value below is a Settings field; anything omitted uses its default.

APP_NAME=Servo Control MVP
VERSION=0.2.0

# --- network ---
API_HOST=127.0.0.1
API_PORT=8000
RELAY_CHUNK_BYTES=128

# --- storage ---
DB_PATH=/home/arduino/servo_mvp.db
LOG_FILE=/home/arduino/logs/app.jsonl
LOG_LEVEL=INFO
# Events forwarded from the MCU side (backlog D3) - a separate file so a
# volume spike on either side cannot evict the other's history.
MCU_LOG_FILE=/home/arduino/logs/mcu.jsonl
MCU_LOG_MAX_BYTES=10000000

# --- travel window -----------------------------------------------------
# Operators asked for +/-90 deg. 180 deg output = 264 servo deg = 3004
# encoder counts, which fits inside ONE servo turn (4096) with margin.
# To widen the window, change these two numbers. If the span ever exceeds
# one servo turn, also set MULTI_TURN_ENABLED=true (and accept the
# resolution cost of ANGLE_RESOLUTION > 1).
OUTPUT_MIN_DEG=-90.0
OUTPUT_MAX_DEG=90.0

# One encoder count at the output = (360/4096) * (30/44) = 0.0599 deg.
OUTPUT_STEP_DEG=0.06

# --- motion ------------------------------------------------------------
DEFAULT_SPEED_DPS=30.0
# Measured ceiling: the servo saturates near 1100 counts/s (~66 deg/s at
# the output) no matter what is commanded. 60 stays inside that.
MAX_SPEED_DPS=60.0
DEFAULT_ACCELERATION=50
# Measured: nothing changes above ~50, despite the table allowing 254.
MAX_ACCELERATION=254

# +1 or -1. Bench-confirmed +1 for our mounting; a reversed servo needs -1.
SERVO_DIRECTION=1

# --- servo hardware ----------------------------------------------------
# Measured landing error by dead zone: 0 -> 0.06 deg, 1 -> 0.10, 8 -> 0.52,
# 32 -> 1.98. Zero is the accurate choice; the factory default is 1.
SERVO_DEADBAND_COUNTS=0

# Multi-turn absolute positioning. Not needed while the travel window fits
# in one servo turn. Bench-confirmed working at amplification 1 (which
# keeps the finest 0.06 deg/step resolution).
MULTI_TURN_ENABLED=false
ANGLE_RESOLUTION=1

# --- behaviour ---------------------------------------------------------
SETTLING_SECONDS=1.5
GUARD_MOVE_TO_LOCK=false
FINE_APPROACH_ENABLED=false
FINE_APPROACH_OVERSHOOT_DEG=1.0
FINE_APPROACH_TIMEOUT_SECONDS=30.0

# --- telemetry ---------------------------------------------------------
SAMPLER_INTERVAL_SECONDS=1.0
TELEMETRY_RETENTION_DAYS=60
TELEMETRY_PURGE_INTERVAL_SECONDS=3600.0
EXPORT_MAX_ROWS=50000
