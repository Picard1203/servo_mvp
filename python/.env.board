# Board runtime settings.
#
# COPY THIS TO .env ON THE BOARD ONLY:
#     cp .env.board .env
#
# Do NOT create .env on a development machine: it turns on the real servo
# backend, and the test suite would then try to talk to hardware that is not
# there. With no .env the defaults keep everything on the simulator.

APP_NAME=Servo Control MVP
VERSION=0.2.0

# --- network -----------------------------------------------------------
# 0.0.0.0 so the Ethernet relay and any browser on the LAN can reach it.
API_HOST=0.0.0.0
API_PORT=8000
RELAY_CHUNK_BYTES=224

# --- storage -----------------------------------------------------------
# RELATIVE ON PURPOSE. The Python side runs inside a container where HOME is
# /home/app, not /home/arduino. A relative path resolves inside the mounted
# app folder, so the file persists and is reachable from outside the
# container; an absolute /home/arduino/... path is not.
DB_PATH=servo_mvp.db
LOG_FILE=servo_mvp.jsonl
LOG_LEVEL=INFO
# Events forwarded from the MCU side (backlog D3) - relative for the same
# reason as LOG_FILE above, and deliberately a separate file/rotation.
MCU_LOG_FILE=mcu.jsonl

# --- drive the real servo ----------------------------------------------
USE_HARDWARE_SERVO=true

# --- travel window (+/-90 deg = 3004 counts, inside one servo turn) -----
OUTPUT_MIN_DEG=-90.0
OUTPUT_MAX_DEG=90.0
OUTPUT_STEP_DEG=0.06

# --- motion (measured on the bench) ------------------------------------
DEFAULT_SPEED_DPS=30.0
MAX_SPEED_DPS=60.0
DEFAULT_ACCELERATION=50
MAX_ACCELERATION=254
SERVO_DIRECTION=1

# --- servo hardware ----------------------------------------------------
SERVO_DEADBAND_COUNTS=0
MULTI_TURN_ENABLED=false
ANGLE_RESOLUTION=1

# --- behaviour ---------------------------------------------------------
SETTLING_SECONDS=1.5
GUARD_MOVE_TO_LOCK=false
FINE_APPROACH_ENABLED=false
FINE_APPROACH_OVERSHOOT_DEG=1.0
FINE_APPROACH_TIMEOUT_SECONDS=30.0

# --- telemetry ---------------------------------------------------------
SAMPLER_INTERVAL_SECONDS=0.5
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_PURGE_INTERVAL_SECONDS=3600.0
EXPORT_MAX_ROWS=50000
