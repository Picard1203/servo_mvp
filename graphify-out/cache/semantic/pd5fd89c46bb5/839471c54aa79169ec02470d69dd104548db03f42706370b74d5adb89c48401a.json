{"nodes": [{"id": "docs_audit_failures_indistinguishable_from_data", "label": "Failures Never Distinguishable From Data", "file_type": "rationale", "rationale": "Root cause shared by a chain of four defects: a failed read produced an all-zero snapshot that was indistinguishable from a genuine reading of position 0, so downstream code stored it as truth.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_telemetrysnapshot_valid", "label": "TelemetrySnapshot.valid", "file_type": "concept", "rationale": "The sketch always sent a valid flag as field 0, but Python parsed and discarded it. Adding the field lets an unanswered read stop masquerading as position zero.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_invalidreadingerror", "label": "InvalidReadingError", "file_type": "concept", "rationale": "Calibration must refuse a reading the servo never gave; previously it stored the zero that made half the travel unreachable. Surfaces as HTTP 409 reason=invalid_reading.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_outoftravelerror", "label": "OutOfTravelError", "file_type": "concept", "rationale": "Unreachable targets are refused rather than silently clamped, as HTTP 422 reason=out_of_travel naming the range that IS reachable.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_centre_of_travel_baseline", "label": "Centre-Of-Travel Default Baseline", "file_type": "rationale", "rationale": "With no datum captured the baseline used to be count 0, putting the entire negative half out of reach before the operator touched anything. Now counts_per_turn / 2.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_off_centre_datum_warning", "label": "Off-Centre Datum Warning", "file_type": "concept", "rationale": "If the captured datum leaves part of the configured window unreachable, log it with numbers rather than let a servo that stops early reveal it.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_bridge_serialisation_rlock", "label": "Bridge Serialisation RLock", "file_type": "concept", "rationale": "An RLock plus a 0.25s read cache: the sampler thread and every HTTP request called Bridge.call concurrently, and interleaved message ids produced 'Response for unknown msgid' and 10s timeouts.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_silent_clamping", "label": "Silent Servo Clamping", "file_type": "rationale", "rationale": "The servo is configured min angle limit 0, max 4095 and clamps silently: it stops at 0 and still acknowledges the command, so nothing upstream sees a failure.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_datum_at_zero_strands_negative_half", "label": "Datum At Zero Strands The Negative Half", "file_type": "rationale", "rationale": "With the baseline at count 0, -90 deg maps to count -1502, which the servo cannot reach. Reproduced by the native test range_a_datum_at_zero_strands_the_negative_half.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_coverage_not_correctness", "label": "Coverage Is Not Correctness", "file_type": "rationale", "rationale": "100% line coverage did not stop any of the six defects: it means every line ran, not that every assumption was questioned.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_relay_untested", "label": "Relay And Controller Have No Automated Coverage", "file_type": "rationale", "rationale": "Every bug in this project lived in the relay and controller: available() vs accept(), accept-before-detect ordering, the missing yield, the missing lock. Native tests cover pure maths only.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_audit_native_tests_pure_maths", "label": "Native Tests Cover Pure Maths Only", "file_type": "rationale", "rationale": "164 host checks cover sign-magnitude decoding, angle conversion and status bits. None of the six defects were maths, so the suite could not have caught them.", "source_file": "docs/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_audit_failures_indistinguishable_from_data", "target": "docs_audit_telemetrysnapshot_valid", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_failures_indistinguishable_from_data", "target": "docs_audit_invalidreadingerror", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_failures_indistinguishable_from_data", "target": "docs_audit_datum_at_zero_strands_negative_half", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_datum_at_zero_strands_negative_half", "target": "docs_audit_centre_of_travel_baseline", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_datum_at_zero_strands_negative_half", "target": "docs_audit_silent_clamping", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_silent_clamping", "target": "docs_audit_outoftravelerror", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_centre_of_travel_baseline", "target": "docs_audit_off_centre_datum_warning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_bridge_serialisation_rlock", "target": "docs_audit_failures_indistinguishable_from_data", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_relay_untested", "target": "docs_audit_coverage_not_correctness", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_native_tests_pure_maths", "target": "docs_audit_coverage_not_correctness", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "weight": 1.0}, {"source": "docs_audit_relay_untested", "target": "sketch_src_relay_notes_accept_not_available", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/AUDIT.md", "source_location": null, "we